# Copy this file to .env and fill in real values. Never commit .env.
# Service role key is found in Supabase Dashboard -> Project Settings -> API.
# It bypasses RLS — local/admin scripts only, never used by the app.
SUPABASE_URL=https://amwzkqlhskicfbuikzpl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: defaults for scripts/set-admin-password.ts so you can omit CLI args.
TARGET_EMAIL=
NEW_PASSWORD=

# PayPal client ID injected into the web bundle at build time (webpack
# DefinePlugin). Client IDs are PUBLIC, not secret. Leave unset to use the
# sandbox fallback baked into src/lib/paypal.ts; set your live client ID here to
# go live. MUST match the PayPal app whose PAYPAL_CLIENT_ID/PAYPAL_SECRET are set
# on the edge functions, or create/capture will fail.
PAYPAL_CLIENT_ID=

# Cloudflare Turnstile SITE key (public), injected into the web bundle. Leave
# unset to keep CAPTCHA off. When set, the contact form, newsletter, sign-up and
# login render an (almost always invisible) Turnstile widget and send its token.
# The matching SECRET key goes in two places — never here:
#   • `supabase secrets set TURNSTILE_SECRET_KEY=…` (contact / newsletter)
#   • Supabase dashboard → Authentication → Bot and Abuse Protection (auth)
# On Vercel, set it under Project → Settings → Environment Variables.
TURNSTILE_SITE_KEY=
