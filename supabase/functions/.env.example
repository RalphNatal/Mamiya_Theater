# ─────────────────────────────────────────────────────────────────────────
# Supabase EDGE FUNCTION secrets (Stripe / PayPal / email / return URLs).
#
# These are DIFFERENT from the repo-root .env (that one feeds the webpack build
# and the Node scripts). Nothing here is ever bundled into the browser.
#
#   • Local dev:  copy this file to `supabase/functions/.env`, fill it in, then
#                 `supabase functions serve --env-file supabase/functions/.env`
#   • Production: DON'T deploy this file — set each value as a project secret:
#                 `supabase secrets set STRIPE_SECRET_KEY=sk_live_... ...`
#
# Never commit the filled-in .env (only this .example).
# ─────────────────────────────────────────────────────────────────────────

# ── Stripe ──
# Secret API key. Test key locally, live key in production.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Signing secret for the checkout.session.completed webhook.
#   • Local:      the whsec_... that `stripe listen` prints on startup.
#   • Production: the whsec_... shown when you add the endpoint in the Stripe
#                 Dashboard (Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Return URLs (fixes the localhost-redirect bug) ──
# Canonical site URL. Set this in PRODUCTION to your deployed domain so Stripe
# sends buyers back there after payment. LEAVE IT UNSET LOCALLY — with it unset,
# checkout returns to the request origin / localhost:3000 automatically, so a
# stale prod value can't redirect your local testing to production.
# FRONTEND_URL=https://mamiya-theater.vercel.app
#
# Extra origins trusted to self-return when FRONTEND_URL is unset (comma-
# separated). localhost:3000 is always trusted; add preview/staging URLs here.
# ALLOWED_ORIGINS=https://mamiya-theater-git-staging.vercel.app

# ── PayPal ── (second checkout option)
PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
PAYPAL_SECRET=xxxxxxxxxxxxxxxxxxxx
# Sandbox host in test, https://api-m.paypal.com in production.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook id used to verify inbound PayPal webhooks (the paypal-webhook backstop
# that finalizes a purchase if the buyer's browser drops mid-capture). Create a
# webhook in the PayPal Developer Dashboard → your app → Webhooks, subscribed to
# PAYMENT.CAPTURE.COMPLETED, pointed at the deployed paypal-webhook URL; PayPal
# then shows the Webhook ID (looks like 1AB23456CD789012E). Use the sandbox
# app's webhook id in test and the live app's in production.
PAYPAL_WEBHOOK_ID=xxxxxxxxxxxxxxxxxxxx

# ── Confirmation email (Resend) ──
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Mamiya Theater <tickets@your-domain.com>
# Inbox that public contact-form enquiries are emailed to (contact-message fn).
# Optional — if unset it defaults to mamiya@saintlouishawaii.org.
CONTACT_NOTIFY_EMAIL=mamiya@saintlouishawaii.org

# ── Supabase (LOCAL serve only) ──
# When deployed, Supabase auto-injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# into every function — you cannot and need not set them as secrets. You only
# need them here if you run `functions serve` against the REMOTE project instead
# of a local `supabase start` stack.
# SUPABASE_URL=https://amwzkqlhskicfbuikzpl.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
